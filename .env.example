BOT_TOKEN=123456:replace-me
BOT_CLIENT_ID=
BOT_USERNAME=igraV1000_bot
# Bot delivery mode: auto | webhook | polling | off
# auto → webhook in production (public https WEBAPP_URL, DEV_MODE=false),
#        long polling for local dev. Webhook avoids the getUpdates conflict
#        that happens when two instances poll the same token (Render deploys).
BOT_MODE=auto
WEBAPP_URL=https://your-app.onrender.com
API_HOST=0.0.0.0
API_PORT=8000
# Allow local browser testing without Telegram initData
DEV_MODE=true
CORS_ORIGINS=*
# Optional; defaults to hash of BOT_TOKEN
SESSION_SECRET=
